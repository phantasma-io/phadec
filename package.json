{
  "name": "pha-decode",
  "version": "0.3.1",
  "description": "Phantasma transaction, contract, ROM, and event decoder CLI",
  "type": "module",
  "bin": {
    "pha-decode": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phantasma-io/pha-decode.git"
  },
  "scripts": {
