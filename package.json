    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "bip32": "^5.0.1",
    "bip39": "^3.1.0",
